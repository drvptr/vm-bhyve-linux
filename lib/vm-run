# ============================================================================
# Linux/QEMU port notes - read this before the rest of the file.
#
# This is not a mechanical command-swap like the other files: bhyve and QEMU
# have genuinely different architectures, so a few things were redesigned
# rather than translated. The big ones:
#
# 1. No manual PCI slot/bus/func bookkeeping. bhyve requires you to hand out
#    -s bus:slot:func for every device; QEMU auto-assigns PCI addresses.
#    All of _slot/_bus/_func/_maxslots/start_slot/install_slot are gone.
#
# 2. No separate bootloader pass. bhyveload/grub-bhyve exist because bhyve
#    has no firmware of its own for BIOS-mode boots. QEMU has SeaBIOS (and
#    OVMF for UEFI) built in, so guest::load and everything around _com is
#    gone entirely.
#
# 3. QEMU survives a guest-initiated reboot inside the same process - bhyve
#    does not, which is *why* the original has a "while true; run bhyve;
#    check exit code; maybe loop" structure. Under QEMU that loop now only
#    ever re-executes for an explicit 'vm restart' (see vm::handle_exit) -
#    a normal in-guest reboot just keeps running, no wrapper involvement.
#    on_restart is therefore a no-op here; see vm::handle_exit for why.
#
# 4. Install media now uses '-boot once=d' (boot the CD once, then fall
#    through to the normal boot order on any later internal reset) instead
#    of the iso-then-loop-then-clear dance the original needs to get from
#    "boot installer" to "boot the freshly installed disk" - QEMU handles
#    that natively so nulliso_fix and the fbuf "clear wait" hack are gone.
#
# Known rough edges / assumptions, called out again inline where relevant:
#  - OVMF firmware path is guessed (Debian/Ubuntu default) - adjust for
#    your distro if it's somewhere else.
#  - Audio uses pipewire; change vm::qemu_device_sound if your host uses
#    pulseaudio/alsa instead.
#  - graphics_res / VNC "wait" can't be replicated exactly (see
#    vm::qemu_device_fbuf) - the guest boots CPU-paused instead, you need
#    to resume it yourself via QMP once connected.
#  - vm::qemu_device_networking still just loops and calls switch::provision
#    per interface, same as the original - actually building the QEMU
#    -netdev/-device args for a tap is switch::standard::provision's job
#    (in vm-switch-standard, not this file). It needs to tag every tap it
#    creates with 'ip link set <tap> alias "vmnet/<name>/<num>/<switch>"'
#    to match what vm-switch.sh/vm-info.sh already expect to find.
# ============================================================================

# 'vm _run'
# run a virtual machine
# this is the background process that does all the work
# in most cases this should not be run directly
#
# @param string _name the name of the guest to run
# @param optional string _iso the iso file for an install
#
vm::run(){
    local _name _iso _iso_dev
    local _cpu _memory _bootdisk _bootdisk_dev _uuid _debug _loader
    local _opts _devices _taplist _exit _passdev
    local _comports _comstring _logpath="/dev/null" _run=1
    local _qemu_options _bhyve_options _action _boot_opt _accel _pid _tap _seedcmd

    cmd::parse_args "$@"
    shift $?
    _name="$1"
    _iso="$2"

    # try to load datastore details
    datastore::get_guest "${_name}" || exit 5

    # bail out immediately if guest running
    vm::confirm_stopped "${_name}" "1" || exit 10

    if [ -d "${VM_DS_PATH}/${_name}/.cloud-init" ] && [ ! -f "${VM_DS_PATH}/${_name}/seed.iso" ]; then
        # Linux: makefs -t cd9660 doesn't exist here - genisoimage (or its
        # xorriso -as genisoimage shim) is the standard way to build an
        # ISO9660 volume for cloud-init's NoCloud datasource.
        if command -v genisoimage >/dev/null 2>&1; then
            _seedcmd="genisoimage"
        elif command -v xorriso >/dev/null 2>&1; then
            _seedcmd="xorriso -as genisoimage"
        else
            util::err "genisoimage (or xorriso) is required to build seed.iso for cloud-init"
        fi

        ${_seedcmd} -output "${VM_DS_PATH}/${_name}/seed.iso" -volid cidata -joliet -rock \
            "${VM_DS_PATH}/${_name}/.cloud-init" >/dev/null 2>&1 \
            || util::err "Can't write seed.iso for cloud-init"

        util::log "guest" "${_name}" "created ${VM_DS_PATH}/${_name}/seed.iso for cloud-init"
    fi

    config::load "${VM_DS_PATH}/${_name}/${_name}.conf"
    config::get "_memory" "memory"
    config::get "_loader" "loader"
    config::get "_bootdisk" "disk0_name"
    config::get "_bootdisk_dev" "disk0_dev" "file"
    config::get "_comports" "comports" "com1"
    config::get "_uuid" "uuid"
    config::get "_debug" "debug" "no"
    config::get "_bhyve_options" "bhyve_options"
    config::get "_qemu_options" "qemu_options"

    # bhyve_options is bhyve CLI syntax and would almost certainly be wrong
    # for qemu - warn rather than silently drop it or silently apply garbage
    [ -n "${_bhyve_options}" ] && \
        util::log "guest" "${_name}" "warning; 'bhyve_options' is ignored under Linux/QEMU - set 'qemu_options' instead"

    # generate a uuid if we don't have one already
    if [ -z "${_uuid}" ]; then
        _uuid=$(uuidgen)
        config::set "${_name}" "uuid" "${_uuid}"
    fi

    # get cpu topology
    vm::__cpu "_cpu"

    util::log_rotate "guest" "${_name}"
    util::log "guest" "${_name}" \
      "initialising" \
      " [loader: ${_loader}]" \
      " [cpu: ${_cpu}]" \
      " [memory: ${_memory}]" \
      " [com ports: ${_comports}]" \
      " [uuid: ${_uuid}]" \
      " [debug mode: ${_debug}]" \
      " [primary disk: ${_bootdisk}]" \
      " [primary disk dev: ${_bootdisk_dev}]"

    # check basic settings
    if [ -z "${_loader}" -o -z "${_cpu}" -o -z "${_memory}" ]; then
        util::log "guest" "${_name}" "fatal; unable to start - missing required configuration"
        exit 15
    fi

    # kvm acceleration if available, otherwise fall back to (much slower)
    # software emulation rather than failing outright
    if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
        _accel="kvm"
    else
        util::log "guest" "${_name}" "warning; /dev/kvm not accessible, falling back to tcg (software emulation, much slower)"
        _accel="tcg"
    fi

    # base machine/cpu/memory. -nodefaults so we control every device
    # ourselves rather than accepting whatever qemu would add by default
    _opts="-machine q35,accel=${_accel} -cpu max -smp ${_cpu} -m ${_memory} -nodefaults"
    [ -n "${_uuid}" ] && _opts="${_opts} -uuid ${_uuid}"

    if config::yesno "utctime" yes; then
        _opts="${_opts} -rtc base=utc"
    else
        _opts="${_opts} -rtc base=localtime"
    fi

    # wired/locked memory - relevant for passthrough DMA reliability
    config::yesno "wired_memory" && _opts="${_opts} -overcommit mem-lock=on"

    # if uefi, make sure we have firmware, then update options for uefi support
    if [ "${_loader%-*}" = "uefi" ]; then
        vm::uefi
    fi

    # add any custom qemu options
    [ -n "${_qemu_options}" ] && _opts="${_opts} ${_qemu_options}"

    # if we have passthru, check iommu support now and exit if not available
    config::get "_passdev" "passthru0"

    if [ -n "${_passdev}" ] && [ ! -d /sys/kernel/iommu_groups ] ; then
        util::log "guest" "${_name}" "fatal; pci passthrough not supported on this system (no IOMMU groups - check IOMMU/VT-d/AMD-Vi is enabled in firmware and on the kernel command line)"
        exit 15
    fi
    if [ -n "${_passdev}" ] && [ -z "$(ls -A /sys/kernel/iommu_groups 2>/dev/null)" ]; then
        util::log "guest" "${_name}" "fatal; pci passthrough not supported on this system (no IOMMU groups - check IOMMU/VT-d/AMD-Vi is enabled in firmware and on the kernel command line)"
        exit 15
    fi

    # send qemu's stderr to qemu.log if debug=yes
    util::yesno "${_debug}" && _logpath="${VM_DS_PATH}/${_name}/qemu.log"

    # complete the boot disk path (informational logging only, see above)
    [ -n "${_bootdisk}" ] && vm::get_disk_path "_bootdisk" "${_name}" "${_bootdisk}" "${_bootdisk_dev}"

    # build qemu device string
    vm::qemu_device_comports
    vm::qemu_device_disks
    vm::qemu_device_networking
    vm::qemu_device_rand
    vm::qemu_device_passthru
    vm::qemu_device_fbuf
    vm::qemu_device_mouse
    vm::qemu_device_sound
    vm::qemu_device_console

    vm::lock
    util::log "guest" "${_name}" "booting"
    cd /

    while true; do

        # run any prestart script while guest is fully down
        vm::prestart

        # add install iso or disk image.
        # -boot once=d boots this once, then falls through to the normal
        # boot order (order=c, first hard disk) on any later internal
        # reset - qemu handles the "installer -> boot from disk after
        # install" transition on its own, no loop/reboot-detection needed
        if [ -n "${_iso}" ]; then
            if echo "${_iso}" | grep -iqs '\.iso$'; then
                _iso_dev="-device ahci,id=ahci-install -drive id=installmedia,file=${_iso},format=raw,if=none,media=cdrom,readonly=on -device ide-cd,bus=ahci-install.0,drive=installmedia"
            else
                _iso_dev="-device ahci,id=ahci-install -drive id=installmedia,file=${_iso},format=raw,if=none,readonly=on -device ide-hd,bus=ahci-install.0,drive=installmedia"
            fi
            _boot_opt="-boot once=d,menu=off"
        else
            _iso_dev=""
            _boot_opt="-boot order=c,menu=off"
        fi

        #
        # from this line onward, no more changes in _opts
        #

        # resume if saved vm state found
        if vm::has_saved_state "${_name}"; then
            util::log "guest" "${_name}" "saved vm state found, resuming"
            _opts="${_opts} -incoming file:${VM_DS_PATH}/${_name}/${_name}.save"
        fi

        util::log "guest" "${_name}" " [qemu options: ${_opts}]" \
          " [qemu devices: ${_devices}]" \
          " [qemu console: ${_comstring}]"
        [ -n "${_iso_dev}" ] && util::log "guest" "${_name}" " [qemu install device: ${_iso_dev}]"
        util::log "guest" "${_name}" "starting qemu (run ${_run})"

        # call rctl now as next line will block until qemu exits
        rctl::set &

        # actually run qemu!
        # we're already in the background so we just wait for it to exit
        qemu-system-x86_64 \
            -name "${_name},process=qemu:${_name}" \
            -pidfile "${VM_DS_PATH}/${_name}/${_name}.pid" \
            -qmp "unix:${VM_DS_PATH}/${_name}/${_name}.qmp,server=on,wait=off" \
            -monitor none \
            ${_boot_opt} \
            ${_opts} \
            ${_devices} \
            ${_iso_dev} \
            ${_comstring} \
            2> "${_logpath}"

        # get qemu exit code
        _exit=$?
        util::log "guest" "${_name}" "qemu exited with status ${_exit}"

        # remove any console sockets
        rm -f ${VM_DS_PATH}/${_name}/vtcon.* >/dev/null 2>&1
        rm -f "${VM_DS_PATH}/${_name}/${_name}.qmp" >/dev/null 2>&1

        # suspend
        [ -f "${VM_DS_PATH}/${_name}/suspending.lock" ] && break

        # decide what to do with exit code
        vm::handle_exit "_action" ${_exit}
        [ "${_action}" != "restart" ] && break

        util::log "guest" "${_name}" "restarting"

        # remove install iso so guest reboots from disk if this was an
        # explicit 'vm restart' during an install
        _iso=""
        _run=$((_run + 1))
    done

    # destroy taps
    for _tap in ${_taplist}; do
        util::log "guest" "${_name}" "destroying network device ${_tap}"
        ip link delete "${_tap}" >/dev/null 2>&1
    done

    if [ -e "${VM_DS_PATH}/${_name}/suspending.lock" ]; then
        util::log "guest" "${_name}" "suspended"
    else
        util::log "guest" "${_name}" "stopped"
    fi

    # belt-and-suspenders: make sure nothing is left running under this pid
    _pid=$(vm::getpid "${_name}")
    if [ -n "${_pid}" ] && kill -0 "${_pid}" 2>/dev/null; then
        kill -KILL "${_pid}" >/dev/null 2>&1
    fi
    rm -f "${VM_DS_PATH}/${_name}/${_name}.pid" "${VM_DS_PATH}/${_name}/${_name}.qmp" >/dev/null 2>&1

    vm::unlock
    exit ${_exit}
}

# creates options to use uefi firmware (OVMF)
#
# Linux: bhyve's proprietary BHYVE_UEFI*.fd blobs are replaced by OVMF,
# the standard QEMU/KVM UEFI firmware (edk2 project). The exact install
# path varies by distro:
#   Debian/Ubuntu (package 'ovmf'):        /usr/share/OVMF/OVMF_{CODE,VARS}.fd
#   Fedora/RHEL (package 'edk2-ovmf'):     /usr/share/edk2/ovmf/OVMF_{CODE,VARS}.fd
#   Arch (package 'edk2-ovmf'):            /usr/share/edk2-ovmf/x64/OVMF_{CODE,VARS}.4m.fd
# This defaults to the Debian/Ubuntu path - adjust below if you're on
# something else. There's no direct OVMF equivalent of uefi-csm/uefi-devel
# (CSM is a legacy-BIOS-compat layer that isn't part of a normal OVMF
# build), so both fall back to the standard firmware with a warning.
#
# @modifies _opts _uefi
#
vm::uefi(){
    local _bootrom="/usr/share/OVMF/OVMF_CODE.fd"
    local _vars_template="/usr/share/OVMF/OVMF_VARS.fd"

    case "${_loader}" in
        uefi-custom)
            _bootrom="${VM_DS_PATH}/.config/OVMF_CODE.fd"
            ;;
        uefi-csm|uefi-devel)
            util::log "guest" "${_name}" "warning; '${_loader}' has no direct OVMF equivalent on Linux, using standard OVMF firmware instead"
            ;;
    esac

    if [ ! -e "${_bootrom}" ]; then
        util::log "guest" "${_name}" "fatal; unable to locate firmware ${_bootrom}"
        exit 15
    fi

    _opts="${_opts} -drive if=pflash,format=raw,readonly=on,file=${_bootrom}"

    # should we store uefi vars?
    if config::yesno "uefi_vars"; then

        # do we already have a storage file for this guest?
        if [ -e "${VM_DS_PATH}/${_name}/uefi-vars.fd" ]; then
            :
        elif [ -e "${_vars_template}" ]; then
            cp "${_vars_template}" "${VM_DS_PATH}/${_name}/uefi-vars.fd"
        else
            util::log "guest" "${_name}" "fatal; unable to locate UEFI vars template ${_vars_template}"
            exit 15
        fi

        _opts="${_opts} -drive if=pflash,format=raw,file=${VM_DS_PATH}/${_name}/uefi-vars.fd"
    fi

    _uefi="yes"
}

# decide how to handle a qemu exit code
#
# Linux/QEMU: this is a fundamentally different situation to bhyve. bhyve
# exits every time the guest reboots, which is *why* the original inspects
# the exit code to decide whether to relaunch it - that's how it implements
# "reboot support" at all. QEMU handles a guest-initiated reboot internally
# and just keeps running, so it only ever gets here because the guest
# cleanly powered itself off (exit 0), or because we killed it (nonzero /
# signal), or it crashed (nonzero). There's no "the guest wants to reboot"
# exit code to catch anymore, so on_restart has nothing left to control -
# the only remaining restart trigger is the explicit marker file that
# core::restart drops before stopping the guest.
#
# @param string _var variable to put action into
# @param int _code qemu exit code
#
vm::handle_exit(){
    local _var="$1"
    local _code="$2"

    if [ "${_code}" = "0" ] && [ -e "${VM_DS_PATH}/${_name}/restart" ]; then
        setvar "${_var}" "restart"
        unlink "${VM_DS_PATH}/${_name}/restart" >/dev/null 2>&1
    elif [ "${_code}" = "0" ]; then
        setvar "${_var}" "shutdown"
    else
        config::get "${_var}" "on_fault" "shutdown"
    fi
}

# lock a vm
# stop another instance being started on this or another host
# we write hostname so vm-bhyve can inform user which host locked a vm
#
# @param string - the name of the guest to lock
#
vm::lock(){
    hostname > "${VM_DS_PATH}/${_name}/run.lock"
}

# unlock a vm
#
# @param string - the name of the guest to unlock
#
vm::unlock(){
    unlink "${VM_DS_PATH}/${_name}/run.lock" >/dev/null 2>&1
    unlink "${VM_DS_PATH}/${_name}/suspending.lock" >/dev/null 2>&1
    unlink "${VM_DS_PATH}/${_name}/console" >/dev/null 2>&1
}

# create the qemu chardev/device string for guest com ports.
#
# Linux: no nmdm here - each com port becomes a unix socket chardev.
# core::console (vm-core.sh) already expects to find that socket path in
# $vm_dir/{guest}/console and connect to it with socat, so the format
# written to that file ("port=path") must stay exactly as it is.
#
# @modifies _comstring
#
vm::qemu_device_comports(){
    local _port _num=1 _tmux_name _port_name

    unlink "${VM_DS_PATH}/${_name}/console" >/dev/null 2>&1

    for _port in ${_comports}; do
        if [ ${_num} -eq 1 ]; then
            # if tmux mode, log this to the console data
            if [ -n "${VM_OPT_TMUX}" ]; then
                _tmux_name=$(echo "${_name}" | tr "." "~")
                echo "${_port}=tmux/${_tmux_name}" >> "${VM_DS_PATH}/${_name}/console"
            fi

            # if foreground mode, attach this port straight to our stdio
            if [ -n "${VM_OPT_FOREGROUND}" ]; then
                _comstring="-chardev stdio,id=${_port},signal=off -device isa-serial,chardev=${_port}"
                _num=$((_num + 1))
                continue
            fi
        fi

        # unix socket chardev, one per com port
        _port_name="${VM_DS_PATH}/${_name}/${_name}.${_port}"
        rm -f "${_port_name}" >/dev/null 2>&1

        echo "${_port}=${_port_name}" >> "${VM_DS_PATH}/${_name}/console"
        _comstring="${_comstring}${_comstring:+ }-chardev socket,id=${_port},path=${_port_name},server=on,wait=off -device isa-serial,chardev=${_port}"
        _num=$((_num + 1))
    done
}

# get qemu device string for disk devices
#
# Linux: no PCI slot/bus/func bookkeeping needed - qemu auto-addresses
# everything, so this is considerably simpler than the bhyve version (and
# the ahci_device_limit "pack N disks onto one controller to save slots"
# optimisation doesn't apply either - every ahci-hd/ahci-cd disk just gets
# its own small ahci controller, since PCI addresses aren't scarce here).
#
# @modifies _devices
#
vm::qemu_device_disks(){
    local _disk _type _dev _path _opts _num=0

    while true; do
        config::get "_disk" "disk${_num}_name"
        config::get "_type" "disk${_num}_type"
        [ -z "${_disk}" -o -z "${_type}" ] && break

        config::get "_dev" "disk${_num}_dev"
        config::get "_opts" "disk${_num}_opts"

        vm::get_disk_path "_path" "${_name}" "${_disk}" "${_dev}"

        case "${_type}" in
            ahci-hd)
                _devices="${_devices} -device ahci,id=ahci${_num}"
                _devices="${_devices} -drive id=disk${_num},file=${_path},format=raw,if=none"
                _devices="${_devices} -device ide-hd,bus=ahci${_num}.0,drive=disk${_num}${_opts:+,${_opts}}"
                ;;
            ahci-cd)
                _devices="${_devices} -device ahci,id=ahci${_num}"
                _devices="${_devices} -drive id=disk${_num},file=${_path},format=raw,if=none,media=cdrom,readonly=on"
                _devices="${_devices} -device ide-cd,bus=ahci${_num}.0,drive=disk${_num}"
                ;;
            nvme)
                _devices="${_devices} -drive id=disk${_num},file=${_path},format=raw,if=none"
                _devices="${_devices} -device nvme,drive=disk${_num},serial=disk${_num}${_opts:+,${_opts}}"
                ;;
            virtio-blk|*)
                [ "${_type}" != "virtio-blk" ] && \
                    util::log "guest" "${_name}" "warning; unrecognised disk type '${_type}' for disk${_num}, defaulting to virtio-blk"
                _devices="${_devices} -drive id=disk${_num},file=${_path},format=raw,if=none,cache=writeback,discard=unmap"
                _devices="${_devices} -device virtio-blk-pci,drive=disk${_num}${_opts:+,${_opts}}"
                ;;
        esac

        _num=$((_num + 1))
    done
}

# get qemu device string for networking.
# actual tap creation/tagging and building the -netdev/-device args for
# each interface is switch::provision's job (delegates to
# switch::standard::provision et al, in the not-yet-ported vm-switch-*
# files) - this just drives the loop, same as the original.
#
# @modifies _taplist (populated by switch::provision)
#
vm::qemu_device_networking(){
    local _emulation _num=0

    while true; do
        config::get "_emulation" "network${_num}_type"
        [ -z "${_emulation}" ] && break

        switch::provision
        _num=$((_num + 1))
    done
}

# check if user wants a virtio-rng device
#
# @modifies _devices
#
vm::qemu_device_rand(){
    if config::yesno "virt_random"; then
        _devices="${_devices} -object rng-random,id=rng0,filename=/dev/urandom -device virtio-rng-pci,rng=rng0"
    fi
}

# add vnc + graphics adapter
#
# Linux/QEMU caveats vs bhyve's fbuf device:
#  - graphics_res isn't directly settable the way bhyve's w=/h= is - the
#    guest OS picks its own resolution once booted. Logged as a warning
#    rather than silently ignored.
#  - "wait" can't auto-resume on client connect the way bhyve's fbuf,wait
#    does - the closest we can do is start the CPU paused (-S) and leave
#    resuming it (via QMP 'cont') up to you once you've connected.
#
# @modifies _devices
#
vm::qemu_device_fbuf(){
    local _port _listen _res _pass _vga _wait _display

    # only works in uefi mode (matches the original - fbuf needs a real
    # graphics-capable firmware path)
    [ -z "${_uefi}" ] && return 0

    ! config::yesno "graphics" && return 0

    config::get "_port" "graphics_port"
    config::get "_listen" "graphics_listen"
    config::get "_res" "graphics_res"
    config::get "_vga" "graphics_vga"
    config::get "_pass" "vnc_password"
    config::get "_wait" "graphics_wait" "auto"

    [ "${_wait}" = "auto" -a -z "${_iso}" ] && _wait="no"

    if [ -z "${_port}" ]; then
        vm::find_available_net_port "_port" "5900"

        if [ -z "${_port}" ]; then
            util::log "guest" "${_name}" "warning; unable to allocate a network port for graphics/vnc"
            return 1
        fi

        util::log "guest" "${_name}" "dynamically allocated port ${_port} for vnc connections"
    fi

    # qemu's -vnc takes a display number, not a raw port (port = 5900 + display)
    _display=$((_port - 5900))

    if [ -n "${_pass}" ]; then
        _devices="${_devices} -object secret,id=vnc-pw-${_name},data=${_pass}"
        _devices="${_devices} -vnc ${_listen:-0.0.0.0}:${_display},password-secret=vnc-pw-${_name}"
    else
        _devices="${_devices} -vnc ${_listen:-0.0.0.0}:${_display}"
    fi

    _devices="${_devices} -device ${_vga:-VGA}"

    [ -n "${_res}" ] && \
        util::log "guest" "${_name}" "warning; graphics_res has no qemu equivalent - set the resolution from inside the guest"

    util::yesno "${_wait}" && _opts="${_opts} -S"

    # write vnc port to console data
    echo "vnc=${_listen:-0.0.0.0}:${_port}" >> "${VM_DS_PATH}/${_name}/console"
}

# add a usb tablet (absolute pointer) device
#
# @modifies _devices
#
vm::qemu_device_mouse(){
    if config::yesno "xhci_mouse"; then
        _devices="${_devices} -device qemu-xhci,id=xhci0 -device usb-tablet,bus=xhci0.0"
    fi
}

# add an audio device
#
# Linux: best-effort - assumes pipewire is available on the host. If your
# host uses pulseaudio or plain alsa instead, change the -audiodev driver
# below (driver=pa or driver=alsa respectively).
#
# @modifies _devices
#
vm::qemu_device_sound(){
    if config::yesno "sound"; then
        _devices="${_devices} -audiodev pipewire,id=snd0 -device ich9-intel-hda -device hda-duplex,audiodev=snd0"
    fi
}

# add virtio-console devices to the guest
#
# Linux: each named port becomes a unix socket chardev at the same
# $vm_dir/{guest}/vtcon.<port> path the original used - info::guest_vtcon
# (vm-info.sh) already expects that exact path, so it's kept as-is.
#
# @modifies _devices
#
vm::qemu_device_console(){
    local _console _curr=0 _portpath

    config::get "_console" "virt_console0"
    [ -z "${_console}" ] && return 0

    _devices="${_devices} -device virtio-serial-pci,id=vioserial0"

    while [ -n "${_console}" -a ${_curr} -lt 16 ]; do
        # if set to "yes/on/1", just use the console number as port name
        case "${_console}" in
            [Yy][Ee][Ss]|[Oo][Nn]|1) _console="${_curr}" ;;
        esac

        _portpath="${VM_DS_PATH}/${_name}/vtcon.${_console}"
        rm -f "${_portpath}" >/dev/null 2>&1

        _devices="${_devices} -chardev socket,id=vtcon${_curr},path=${_portpath},server=on,wait=off"
        _devices="${_devices} -device virtserialport,chardev=vtcon${_curr},bus=vioserial0.0,name=${_console}"

        _curr=$((_curr + 1))
        config::get "_console" "virt_console${_curr}"
    done
}

# get any pci passthrough devices
#
# Linux: passthru devices are written as a PCI address matching the host's
# /sys/bus/pci/devices naming (bus:dev.func, or domain:bus:dev.func) rather
# than bhyve's slot/bus/func triples, and the device must already be bound
# to the vfio-pci driver on the host before starting the guest - this
# script doesn't do that binding for you.
#
# @modifies _devices _opts
#
vm::qemu_device_passthru(){
    local _dev _options _num=0

    while true; do
        config::get "_dev" "passthru${_num}"
        config::get "_options" "passthru${_num}_options"
        [ -z "${_dev}" ] && break

        _devices="${_devices} -device vfio-pci,host=${_dev}${_options:+,${_options}}"
        _num=$((_num + 1))
    done

    # passthrough needs the guest's memory locked in place for DMA
    [ ${_num} -ge 1 ] && _opts="${_opts} -overcommit mem-lock=on"
}

# get the path to a disk image depending on type.
# the disk name in configuration is usually the name of the file
# or zvol, directly under the guest directory/dataset.
# if a user wants the disk image anywhere else, they can specify
# the following
# diskX_dev="custom"
# diskX_name="/full/path/to/disk/device/or/file"
#
# unchanged from the original - none of this is FreeBSD-specific. zvol
# paths (/dev/zvol/<dataset>) are identical under OpenZFS on Linux, and
# the iscsi/custom/default cases just build a path or delegate elsewhere
# (see info::__find_iscsi in vm-info.sh for the Linux iscsi lookup).
#
# @param string _var variable to put disk path into
# @param string _name the name of the guest
# @param string _disk the name of the disk
# @param string _disk_dev=file|zvol|sparse-zvol|custom type of device
#
vm::get_disk_path(){
    local _var="$1"
    local _name="$2"
    local _disk="$3"
    local _disk_dev="$4"

    case "${_disk_dev}" in
        zvol)        ;&
        sparse-zvol) setvar "${_var}" "/dev/zvol/${VM_DS_ZFS_DATASET}/${_name}/${_disk}" ;;
        custom|9p)   setvar "${_var}" "${_disk}" ;;
        iscsi)       info::__find_iscsi "${_var}" "${_disk}" ;;
        *)           setvar "${_var}" "${VM_DS_PATH}/${_name}/${_disk}" ;;
    esac
}

# looks for a prestart setting and runs it if possible
# this will execute before each start/reboot
#
# script is given the guest name and full path as arguments
#
# unchanged - just runs an external script, nothing FreeBSD-specific
#
vm::prestart(){
    local _script

    config::get "_script" "prestart" || return 0
    echo "${_script}" | grep -qs '^/'
    [ $? -ne 0 ] && _script="${VM_DS_PATH}/${_name}/${_script}"
    [ ! -x "${_script}" ] && return 1

    util::log "guest" "${_name}" "running prestart script ${_script} ${_name} ${VM_DS_ZFS_DATASET}/${_name}"

    (
      cd "${VM_DS_PATH}/${_name}"
      exec "${_script}" "${_name}" "${VM_DS_ZFS_DATASET}/${_name}"
    )
}

# get a list of all running virtual machines
# this loads a list of all running guests into a global variable,
# one guest per line, in the format "pid guest"
#
# Linux/QEMU: there's no separate bootloader phase (bhyveload/grub-bhyve) -
# qemu boots guests directly, so there's nothing for VM_RUN_LOAD to hold;
# it's kept (always empty) purely so vm::running_check doesn't need
# touching. Guest identity comes from the qemu process's "-name" argument,
# same convention core::stopall (vm-core.sh) already relies on.
#
# @modifies VM_RUN_BHYVE VM_RUN_LOAD
#
vm::running_load(){
    VM_RUN_BHYVE=$(
        ps -eo pid=,args= | \
        sed -n 's/^[[:space:]]*\([0-9][0-9]*\)[[:space:]].*-name[[:space:]]\+\([^,[:space:]]*\).*/\1 \2/p'
    )
    VM_RUN_LOAD=""
}

# see if a specific virtual machine is running
# we search VM_RUN_BHYVE (and, for original-behaviour compatibility,
# VM_RUN_LOAD, which is always empty here - see vm::running_load) looking
# for the specified guest. If found we output "Running" along with the
# PID; if not running we output "Suspended" or "Stopped"
#
# @param string _var variable to put result into
# @param string _name name of the guest to look for
# @return success if running
#
vm::running_check(){
    local _var="$1"
    local _var2="$2"
    local _name="$3"
    local IFS=$'\n'
    local _entry

    for _entry in ${VM_RUN_BHYVE}; do
        if [ "${_entry##* }" = "${_name}" ]; then
            setvar "${_var}" "Running (${_entry%% *})"
            setvar "${_var2}" "${_entry%% *}"
            return 0
        fi
    done

    datastore::get_guest "${_name}"

    if vm::has_saved_state "${_name}"; then
        setvar "${_var}" "Suspended"
    else
        setvar "${_var}" "Stopped"
    fi

    return 1
}

# make sure a virtual machine is not running
# display warning if it is. up to caller to decide whether to continue.
#
# Linux/QEMU: no /dev/vmm to check - "running locally" now means a live
# pid in the guest's .pid file, same source of truth core::stop/core::console
# (vm-core.sh) already use.
#
# @param string _name the guest name
# @param int _skip_lock skip local lock file if guest isn't actually running
# @return success if not running
#
vm::confirm_stopped(){
    local _name="$1"
    local _skip_lock="$2"
    local _host _our_host _pid

    _our_host=$(hostname)

    # check vm-bhyve lock
    # this will err even if guest is running on another node
    if [ -e "${VM_DS_PATH}/${_name}/run.lock" ]; then
        _host=$(head -n 1 "${VM_DS_PATH}/${_name}/run.lock")

        if [ "${_host}" != "${_our_host}" -o "${_skip_lock}" != "1" ]; then
            util::warn "${_name} appears to be running on ${_host} (locked)"
            return 2
        fi
    fi

    # check local machine, just in case guest run manually
    _pid=$(vm::getpid "${_name}")
    if [ -n "${_pid}" ] && kill -0 "${_pid}" 2>/dev/null; then
        util::warn "${_name} appears to be running locally (pid ${_pid})"
        return 1
    fi

    return 0
}

#
# check if the virtual machine has saved state
#
# unchanged - plain file existence check, nothing FreeBSD-specific
#
# @param string _name the guest name
# @return success if the guest has saved state
#
vm::has_saved_state(){
    local _name="$1"

    [ -e "${VM_DS_PATH}/${_name}/${_name}.save" ]
    return $?
}

# generate a static mac address for a guest.
#
# Linux/QEMU: 58:9c:fc is bhyve's registered OUI - swapped for 52:54:00,
# the long-standing QEMU/KVM convention (same one libvirt's default
# networks use), so guests are recognisable as qemu VMs and won't collide
# with anything using the bhyve range.
#
vm::generate_static_mac(){
    local _dev_id=""

    while [ -z "${_dev_id}" -o "${_dev_id}" = "00:00:00" ]; do
          _dev_id=$(openssl rand -hex 3 | sed 's/../&:/g; s/^./0/; s/:$//')
    done

    _mac="52:54:00:${_dev_id}"

    util::log "guest" "${_name}" "generated static mac ${_mac}"
    config::set "${_name}" "network${_num}_mac" "${_mac}"
}

# try to find an available network port to listen on
# this isn't clever enough to differentiate ports on unique ip's yet
#
# Linux: ss (iproute2) instead of netstat (net-tools, often not installed
# by default anymore). Also note BSD netstat prints "addr.port" (dot before
# the port); Linux tools use "addr:port" (colon) - hence -F: not -F.
#
# @param string _var variable to put port into
# @param int _curr the port to start searching from
# @return true if we found a port
#
vm::find_available_net_port(){
    local _var="$1"
    local _curr="$2"
    local _open _line _max _used
    local IFS=$'\n'

    _max=$((_curr + 200))

    _open=$(ss -tln 2>/dev/null | awk 'NR>1{print $4}' | awk -F: '{print $NF}')

    while [ "${_curr}" -lt "${_max}" ]; do
        _used=""

        for _line in ${_open}; do
            [ "${_line}" = "${_curr}" ] && _used="1"
        done

        if [ -z "${_used}" ]; then
            setvar "${_var}" "${_curr}"
            return 0
        fi

        _curr=$((_curr + 1))
    done

    setvar "${_var}" ""
    return 1
}

# remove any values from configuration that should be unique
# such as uuid and mac addresses. these should be generated
# automatically at runtime
#
# unchanged - pure config file manipulation, nothing FreeBSD-specific
#
# @param string _name name of guest to generalise
#
vm::generalise(){
    local _name="$1"
    local _entry _num=0

    config::load "${VM_DS_PATH}/${_name}/${_name}.conf"
    config::remove "${_name}" "uuid"

    while true; do
        config::get "_entry" "network${_num}_mac"
        [ -z "${_entry}" ] && break

        config::remove "${_name}" "network${_num}_mac"
        _num=$((_num + 1))
    done
}

# get number of cpus from the configuration file, and also
# look for sockets/cores/threads options.
# returns the qemu -smp configuration string
#
# unchanged - qemu's "-smp N,sockets=X,cores=Y,threads=Z" syntax happens
# to be the same shape as bhyve's "-c N,sockets=X,cores=Y,threads=Z", so
# this needed no changes at all - just prefix the result with -smp instead
# of -c where it's used (see vm::run).
#
# @param string _var variable to put cpu configuration into
#
vm::__cpu(){
    local _var="$1"
    local _c_cpu _c_socket _c_core _c_thread
    local _config

    config::get "_c_cpu" "cpu"
    [ -n "${_c_cpu}" ] || util::err "fatal; unable to determine cpu count"
    _config="${_c_cpu}"

    config::get "_c_socket" "cpu_sockets"
    config::get "_c_core" "cpu_cores"
    config::get "_c_thread" "cpu_threads"

    [ -n "${_c_socket}" ] && _config="${_config},sockets=${_c_socket}"
    [ -n "${_c_core}" ] && _config="${_config},cores=${_c_core}"
    [ -n "${_c_thread}" ] && _config="${_config},threads=${_c_thread}"

    setvar "${_var}" "${_config}"
}
