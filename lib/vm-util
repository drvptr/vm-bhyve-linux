# make sure we have the right environment
#
# Linux/KVM modules are normally auto-loaded by the kernel/udev when
# supported hardware is detected, and QEMU creates its own TAP interfaces
# on demand - there's nothing to pre-load the way FreeBSD's 'kldload vmm'
# requires. If /dev/kvm is still missing, make one best-effort attempt to
# load the modules ourselves (util::load_vmm) before giving up.
#
util::setup(){
    if [ ! -e /dev/kvm ]; then
        util::load_vmm
        [ -e /dev/kvm ] || util::err "KVM is not available (/dev/kvm missing) - check virtualisation is enabled in firmware and the kvm kernel module is loaded"
    fi
}

# load a kernel module
#
# Linux: modprobe instead of kldload; lsmod instead of kldstat -qm
#
# @param string _mod the module name
#
util::load_module(){
    local _mod="$1"

    lsmod | awk '{print $1}' | grep -qx "${_mod}" && return 0

    modprobe "${_mod}" >/dev/null 2>&1
    [ $? -eq 0 ] || util::err "unable to load ${_mod}"
}

# load the kvm kernel module (and the vendor-specific one alongside it)
#
# Linux equivalent of loading FreeBSD's vmm.ko - loads the generic 'kvm'
# module plus 'kvm_intel' or 'kvm_amd' depending on the host CPU, then
# checks /dev/kvm actually showed up. Modules loading successfully but
# /dev/kvm still not appearing usually means virtualisation extensions
# aren't enabled in firmware (or, for a VM host, nested virt isn't on).
#
# @return 0: success
#         1: failure to load
#         2: not supported (loaded, but /dev/kvm still missing)
#
util::load_vmm(){
    local _rc

    [ -e /dev/kvm ] && return 0

    modprobe kvm >/dev/null 2>&1
    _rc=$?

    case "$(awk -F: '/vendor_id/{print $2; exit}' /proc/cpuinfo 2>/dev/null)" in
        *AuthenticAMD*) modprobe kvm_amd >/dev/null 2>&1 ;;
        *GenuineIntel*) modprobe kvm_intel >/dev/null 2>&1 ;;
    esac

    if [ -e /dev/kvm ]; then
        return 0
    elif [ ${_rc} -ne 0 ]; then
        return 1
    else
        return 2
    fi
}

# check if system has QEMU/KVM support
#
# @return 0 if QEMU/KVM is available
#
util::check_bhyve_support(){
    # vm-bhyve-qemu requires root for most management operations
    [ "$(id -u)" -ne 0 ] && \
        util::err "virtual machines can only be managed as root"

    # allow bypassing host checks
    util::yesno "$vm_disable_host_checks" && return 0

    # check that QEMU is installed
    if ! command -v qemu-system-x86_64 >/dev/null 2>&1; then
        util::err "qemu-system-x86_64 is not installed"
    fi

    # check that KVM device exists
    if [ ! -e /dev/kvm ]; then
        util::err "KVM is not available: /dev/kvm does not exist"
    fi

    # check that KVM is accessible
    if [ ! -r /dev/kvm ] || [ ! -w /dev/kvm ]; then
        util::err "KVM is not accessible: check permissions on /dev/kvm"
    fi

    # check that the kernel exposes KVM
    if [ ! -e /sys/module/kvm ]; then
        util::err "KVM kernel module is not loaded"
    fi

    # check architecture
    case "$(uname -m)" in
        x86_64|amd64)
            ;;
        *)
            util::err "unsupported host architecture: $(uname -m)"
            ;;
    esac
}

# check for passthru support
#
# Linux: an IOMMU (VT-d/AMD-Vi) being enabled and active shows up as
# populated groups under /sys/kernel/iommu_groups - replaces FreeBSD's
# acpidump DMAR-table check and the vmm.amdvi sysctl.
#
# @return success if host has vt-d or amdvi
#
util::check_bhyve_iommu(){
    util::yesno "$vm_disable_host_checks" && return 0

    [ -d /sys/kernel/iommu_groups ] && [ -n "$(ls -A /sys/kernel/iommu_groups 2>/dev/null)" ] && return 0

    return 1
}

# check if suspend/resume is supported
#
# Linux/QEMU: unlike bhyve (where snapshot/suspend support depends on how
# the binary was built), QEMU's migrate-to-file mechanism - what
# core::suspend and vm::run's -incoming handling both use - is a
# standard, always-available feature of any reasonably current QEMU.
# There's no equivalent "your build might not support this" case here.
#
# @return success - always, see above
#
util::check_bhyve_suspend(){
    return 0
}

# restart a local service
# checks if service is running and either starts or restarts
#
# Linux: prefer systemctl when available (works the same on every
# systemd distro), falling back to the SysV-style 'service' wrapper
# that's still commonly present for compatibility.
#
# @param string _serv the name of the service
#
util::restart_service(){
    local _serv="$1"
    local _cmd="restart"

    if command -v systemctl >/dev/null 2>&1; then
        systemctl is-active --quiet "${_serv}" || _cmd="start"
        systemctl "${_cmd}" "${_serv}" >/dev/null 2>&1
        [ $? -eq 0 ] || util::warn "failed to ${_cmd} service ${_serv}"
        return
    fi

    # see if it's actually running
    service ${_serv} status >/dev/null 2>&1
    [ $? -ne 0 ] && _cmd="start"

    service ${_serv} ${_cmd} >/dev/null 2>&1
    [ $? -ne 0 ] && util::warn "failed to ${_cmd} service ${_serv}"
}

