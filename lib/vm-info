# read rx/tx byte counters for any network interface (physical, bridge,
# or tap) straight from sysfs. Replaces netstat -biI parsing.
#
# @param string _var variable to store "rxbytes txbytes" into
# @param string _if interface name
# @return non-zero if the interface doesn't exist
#
info___net_stats(){
    local _var="$1"
    local _if="$2"
    local _rx _tx

    [ -d "/sys/class/net/${_if}/statistics" ] || { config_setvar "${_var}" ""; return 1; }

    _rx=$(cat "/sys/class/net/${_if}/statistics/rx_bytes" 2>/dev/null)
    _tx=$(cat "/sys/class/net/${_if}/statistics/tx_bytes" 2>/dev/null)

    [ -z "${_rx}" -o -z "${_tx}" ] && { config_setvar "${_var}" ""; return 1; }

    config_setvar "${_var}" "${_rx} ${_tx}"
}

# find the tap device for one of a guest's network interfaces.
#
# Linux/QEMU: FreeBSD identifies a guest's tap via 'ifconfig descr
# vmnet/<name>/<num>/<switch>'. Linux has no descr field, but sysfs
# gives us the equivalent 'ifalias' (set with 'ip link set <tap> alias
# ...'). This assumes vm-net tags every tap it creates the same way,
# on creation, with alias "vmnet/<name>/<num>/<switch-or-custom>".
#
# @param string _var_id variable to store the tap device name in
# @param string _var_tag variable to store the full alias string in
# @param string _gname guest name
# @param string _gnum interface number
# @return non-zero if no matching tap is found
#
info___find_tap(){
    local _var_id="$1"
    local _var_tag="$2"
    local _gname="$3"
    local _gnum="$4"
    local _f _alias _if

    for _f in /sys/class/net/*/ifalias; do
        [ -r "${_f}" ] || continue
        _alias=$(cat "${_f}" 2>/dev/null)

        case "${_alias}" in
            "vmnet/${_gname}/${_gnum}/"*)
                _if=$(basename "$(dirname "${_f}")")
                config_setvar "${_var_id}" "${_if}"
                config_setvar "${_var_tag}" "${_alias}"
                return 0
                ;;
        esac
    done

    config_setvar "${_var_id}" ""
    config_setvar "${_var_tag}" ""
    return 1
}

# 'vm info'
# display a wealth of information about all guests, or one specified
#
# @param optional string[multiple] _name name of the guest to display
#
info_guest(){
    local _name="$1"
    # Linux: enumerate every bridge on the system rather than a FreeBSD
    # interface "group" (Linux has no such concept). info___find_bridge
    # only uses this to check bridge *membership* of a specific tap, so
    # a superset of bridges here is harmless.
    local _bridge_list=$(ip -o link show type bridge | awk -F': ' '{print $2}')
    local _ds

    vm_running_load

    # see if guest name(s) provided
    if [ -n "${_name}" ]; then
        while [ -n "${_name}" ]; do
            datastore_get_guest "${_name}" || util_err "unable to locate virtual machine '${_name}'"
            info_guest_show "${_name}"

            shift
            _name="$1"
        done

        exit
    fi

    # show all guests from all datastores
    for _ds in ${VM_DATASTORE_LIST}; do
        datastore_get "${_ds}" || continue

        ls -1 "${VM_DS_PATH}" 2>/dev/null | \
        while read _name; do
            [ -e "${VM_DS_PATH}/${_name}/${_name}.conf" ] && info_guest_show "${_name}"
        done
    done
}

# 'vm switch info'
# display config of each virtual switch as well as stats and connected guests
#
# @param optional string[multiple] _switch name of switch to display
#
info_switch(){
    local _switch="$1"
    local _list

    # load config file manually using non-core function
    # this means we can share the config_output function with guest
    config_load "${vm_dir}/.config/system.conf"
    config_get "_list" "switch_list"

    if [ -n "${_switch}" ]; then
        while [ -n "${_switch}" ]; do
            info_switch_show "${_switch}"

            shift
            _switch="$1"
        done

        exit
    fi

    for _switch in ${_list}; do
        info_switch_show "${_switch}"
    done
}

# display info for one virtual switch
#
# @param string _switch the name of the switch
#
info_switch_show(){
    local _switch="$1"
    local _type _bridge _vale _netgraph _id
    local _INDENT="  "

    [ -z "${_switch}" ] && return 1

    config_get "_type" "type_${_switch}" "standard"
    config_get "_bridge" "bridge_${_switch}"
    config_get "_vale" "vale_${_switch}"
    config_get "_netgraph" "netgraph_${_switch}"


    echo "------------------------"
    echo "Virtual Switch: ${_switch}"
    echo "------------------------"

    echo "${_INDENT}type: ${_type}"
    switch_id "_id" "${_switch}"

    # we don't have a bridge for vale and netgraph switches
    [ "${_type}" != "vale" ] && [ "${_type}" != "netgraph" ] && _bridge="${_id}"

    echo "${_INDENT}ident: ${_id:--}"

    info___output_config "vlan_${_switch}" "vlan"
    info___output_config "ports_${_switch}" "physical-ports"

    if [ -n "${_bridge}" ]; then
        if info___net_stats "_stats" "${_bridge}"; then
            _b_in=$(info___bytes_human "${_stats%% *}")
            _b_out=$(info___bytes_human "${_stats##* }")

            echo "${_INDENT}bytes-in: ${_stats%% *} (${_b_in})"
            echo "${_INDENT}bytes-out: ${_stats##* } (${_b_out})"
        fi

        # show guest ports
        info_switch_ports
    fi

    echo ""
}

# get all guest ports for current bridge
#
info_switch_ports(){
    # Linux: bridge membership lives in sysfs - one entry per member
    # interface under /sys/class/net/<bridge>/brif/. We only show
    # ports that are actually tagged as guest taps (ifalias starting
    # with "vmnet/"), same filtering intent as the FreeBSD "tap*" name
    # match, just driven by the tag instead of the device name.
    local _port_list=$(ls "/sys/class/net/${_bridge}/brif/" 2>/dev/null)
    local _port _guest _alias

    for _port in ${_port_list}; do
        _alias=$(cat "/sys/class/net/${_port}/ifalias" 2>/dev/null)

        case "${_alias}" in
            vmnet/*)
                _guest=$(echo "${_alias}" | cut -d'/' -f2)

                echo ""
                echo "${_INDENT}virtual-port"
                echo "${_INDENT}${_INDENT}device: ${_port}"
                echo "${_INDENT}${_INDENT}vm: ${_guest:--}"
                ;;
        esac
    done
}

# display the info for one guest
#
# @param string _name name of the guest to display
#
info_guest_show(){
    local _name="$1"
    local _conf="${VM_DS_PATH}/${_name}/${_name}.conf"
    local _INDENT="  "
    local _RUN="0"
    local _res_mem _b_res_mem _global_run _port _opt _pid

    [ -z "${_name}" ] && return 1
    [ ! -f "${_conf}" ] && return 1

    config_load "${_conf}"

    # check local and global runstate.
    # Linux/QEMU: there's no /dev/vmm - vm_running_check already gives
    # us the pid, so "running locally" just means that pid is alive.
    vm_running_check "_global_run" "_pid" "${_name}"
    [ -n "${_pid}" ] && kill -0 "${_pid}" 2>/dev/null && _RUN="1"
    _global_run=$(echo "${_global_run}" | tr '[:upper:]' '[:lower:]')

    echo "------------------------"
    echo "Virtual Machine: ${_name}"
    echo "------------------------"

    echo "${_INDENT}state: ${_global_run}"
    echo "${_INDENT}datastore: ${VM_DS_NAME}"

    # basic guest configuration
    info___output_config "loader" "" "none"
    info___output_config "uuid" "" "auto"
    info___output_config "cpu"

    # check for a cpu topology
    config_get "_opt" "cpu_sockets"

    if [ -n "${_opt}" ]; then
        echo -n "${_INDENT}cpu-topology: sockets=${_opt}"
        config_get "_opt" "cpu_cores"
        [ -n "${_opt}" ] && echo -n ", cores=${_opt}"
        config_get "_opt" "cpu_threads"
        [ -n "${_opt}" ] && echo -n ", threads=${_opt}"
        echo ""
    fi

    info___output_config "memory"

    # running system details
    if [ "${_RUN}" = "1" ]; then
        # Linux/QEMU: resident memory comes straight from ps(1) instead
        # of bhyvectl --get-stats. ps reports RSS in KB, convert to bytes
        # to match info___bytes_human's expected unit.
        _res_mem=$(ps -o rss= -p "${_pid}" 2>/dev/null | tr -d ' ')

        if [ -n "${_res_mem}" ]; then
            _res_mem=$((_res_mem * 1024))
            _b_res_mem=$(info___bytes_human "${_res_mem}")
            echo "${_INDENT}memory-resident: ${_res_mem} (${_b_res_mem})"
        fi

        # show com ports
        if [ -e "${VM_DS_PATH}/${_name}/console" ]; then
            echo ""
            echo "${_INDENT}console-ports"

            cat "${VM_DS_PATH}/${_name}/console" | \
            while read _port; do
                echo "${_INDENT}${_INDENT}${_port%%=*}: ${_port##*=}"
            done

            # virtio-console devices
            info_guest_vtcon
        fi
    fi

    # network interfaces
    info_guest_networking

    # disks
    info_guest_disks

    # zfs data
    info_guest_zfs

    echo ""
}

# display any virtio consoles
#
info_guest_vtcon(){
    local _INDENT="    "
    local _console _num=0

    config_get "_console" "virt_console0"
    [ -z "${_console}" ] && return 0

    echo ""

    while [ -n "${_console}" -a ${_num} -lt 16 ]; do
        # if set to "yes/on/1", just use the console number as port name
        case "${_console}" in
            [Yy][Ee][Ss]|[Oo][Nn]|1) _console="${_num}" ;;
        esac

        echo "${_INDENT}vtcon${_num}: ${VM_DS_PATH}/${_name}/vtcon.${_console}"

        _num=$((_num + 1))
        config_get "_console" "virt_console${_num}"
    done
}

# display zfs snapshot/origin data
#
# zfs list/get are identical on Linux (OpenZFS) - nothing to change here.
#
info_guest_zfs(){
   local _INDENT="    "
   local _data

   [ -z "${VM_DS_ZFS}" ] && return 1

   _data=$(zfs list -o name,used,creation -s creation -rHt snapshot "${VM_DS_ZFS_DATASET}/${_name}" | sed "s/^/${_INDENT}/")

   if [ -n "${_data}" ]; then
       echo ""
       echo "  snapshots"
       echo "${_data}"
   fi

   _data=$(zfs get -Ho value origin "${VM_DS_ZFS_DATASET}/${_name}")
   [ "${_data}" = "-" ] && return 0

   echo ""
   echo "  clone-origin"
   echo "    ${_data}"
}

# display disks
#
info_guest_disks(){
    local _num=0
    local _disk _type _dev _path _size _b_size _used _b_used
    local _INDENT="    "

    while true; do
        config_get "_disk" "disk${_num}_name"
        config_get "_type" "disk${_num}_type"
        config_get "_dev" "disk${_num}_dev" "file"
        [ -z "${_disk}" -o -z "${_type}" ] && break

        vm_get_disk_path "_path" "${_name}" "${_disk}" "${_dev}"

        echo ""
        echo "  virtual-disk"
        echo "${_INDENT}number: ${_num}"

        info___output_config "disk${_num}_dev" "device-type" "file"
        info___output_config "disk${_num}_type" "emulation"
        info___output_config "disk${_num}_opts" "options"

        echo "${_INDENT}system-path: ${_path:--}"

        _size=""
        _used=""

        if [ -n "${_path}" ]; then
            case "${_dev}" in
                file)
                    # GNU stat uses -c, not BSD's -f
                    _size=$(stat -c%s "${_path}")
                    # force -k so the *1024 below is always KB -> bytes,
                    # regardless of du's default block size
                    _used=$(du -k "${_path}" | awk '{print $1}')
                    _used=$((_used * 1024))
                    ;;
                zvol|sparse-zvol)
                    # OpenZFS on Linux uses the same /dev/zvol/<dataset>
                    # layout as FreeBSD, and the same zfs get syntax -
                    # nothing to change here.
                    _size=$(zfs get -Hp volsize "${_path#/dev/zvol/}" |cut -f3)
                    _used=$(zfs get -Hp refer "${_path#/dev/zvol/}" |cut -f3)
                    ;;
                iscsi)
                    # Linux: once a LUN is attached it's a normal block
                    # device - ask the kernel for its size directly
                    # instead of parsing FreeBSD's GEOM sysctl tree.
                    _size=$(blockdev --getsize64 "${_path}" 2>/dev/null)
                    _used=${_size}
                    ;;
            esac

            if [ -n "${_size}" -a -n "${_used}" ]; then
                _b_size=$(info___bytes_human "${_size}")
                _b_used=$(info___bytes_human "${_used}")
                echo "${_INDENT}bytes-size: ${_size} (${_b_size})"
                echo "${_INDENT}bytes-used: ${_used} (${_b_used})"
            fi
        fi

        _num=$((_num + 1))
    done
}

# display networking configuration
#
info_guest_networking(){
    local _num=0
    local _int _id _tag _switch _stats _b_in _b_out _mtu _bridge
    local _INDENT="    "

    while true; do
        config_get "_int" "network${_num}_type"
        [ -z "${_int}" ] && break

        echo ""
        echo "  network-interface"
        echo "${_INDENT}number: ${_num}"

        # basic interface config
        info___output_config "network${_num}_type" "emulation"
        info___output_config "network${_num}_switch" "virtual-switch"
        info___output_config "network${_num}_mac" "fixed-mac-address"
        info___output_config "network${_num}_device" "fixed-device"

        # if running, try to get some more interface details
        if [ "${_RUN}" = "1" ]; then
            config_get "_switch" "network${_num}_switch"

            info___find_tap "_id" "_tag" "${_name}" "${_num}"
            info___find_bridge "_bridge" "${_id}"

            _mtu=""
            [ -n "${_id}" ] && _mtu=$(cat "/sys/class/net/${_id}/mtu" 2>/dev/null)

            echo "${_INDENT}active-device: ${_id:--}"
            echo "${_INDENT}desc: ${_tag:--}"
            echo "${_INDENT}mtu: ${_mtu:--}"
            echo "${_INDENT}bridge: ${_bridge:--}"

            if [ -n "${_id}" ] && info___net_stats "_stats" "${_id}"; then
                _b_in=$(info___bytes_human "${_stats%% *}")
                _b_out=$(info___bytes_human "${_stats##* }")

                echo "${_INDENT}bytes-in: ${_stats%% *} (${_b_in})"
                echo "${_INDENT}bytes-out: ${_stats##* } (${_b_out})"
            fi
        fi

        _num=$((_num + 1))
    done
}

# output a single configuration variable
# alwasy called once guest configuration has been loaded
#
# @param string _option config option to display
# @param optional string _title title to display instead of using option name
# @param optional string _default default value to display if not -
#
info___output_config(){
    local _option="$1"
    local _title="$2"
    local _default="$3"
    local _vmi_var

    config_get "_vmi_var" "${_option}" "${_default:--}"
    [ -z "${_title}" ] && _title="${_option}"

    echo "${_INDENT}${_title}: ${_vmi_var}"
}

# try and find the bridge an interface is a member of.
# we do this rather than just use switch_id as
# this should be able to locate the bridge even for devices
# that have been bridged manually and have no switch name configured
#
# Linux: bridge membership is a direct sysfs lookup - no text parsing
# needed, just check whether the member file exists.
#
# @param string _var variable to put value into
# @param string _interface interface to look for
#
info___find_bridge(){
    local _var="$1"
    local _interface="$2"
    local _br

    [ -z "${_interface}" ] && { config_setvar "${_var}" ""; return 1; }

    for _br in ${_bridge_list}; do
        if [ -e "/sys/class/net/${_br}/brif/${_interface}" ]; then
            config_setvar "${_var}" "${_br}"
            return 0
        fi
    done

    config_setvar "${_var}" ""
    return 1
}

# format bytes to human readable
# convert to k,m,g or t
# output rounded number
#
# pure arithmetic (bc) - identical on Linux, nothing to change here.
#
# @param int _val the value to convert
#
info___bytes_human(){
    local _val="$1" _int _ext
    local _dec="$2"
    local _num="$3"

    : ${_dec:=3}
    : ${_val:=0}
    : ${_num:=1}
    _int=${_val%%.*}

    while [ ${_int} -ge 1024 -a ${_num} -lt 5 ]; do
        _val=$(echo "scale=3; ${_val}/1024" | bc)
        _int=${_val%%.*}
        _num=$((_num + 1))
    done

    case "${_num}" in
        1) _ext="B" ;;
        2) _ext="K" ;;
        3) _ext="M" ;;
        4) _ext="G" ;;
        5) _ext="T" ;;
    esac

    export LC_ALL="C"
    printf "%.${_dec}f%s" "${_val}" "${_ext}"
}

# Linux/open-iscsi: FreeBSD's iscsictl -L prints a fixed-width table
# where a LUN's CAM device name sits at a predictable column. open-iscsi
# has no equivalent single command - a logged-in target's LUNs are only
# discoverable by walking sysfs under the matching iscsi_session. This
# is a best-effort translation and hasn't been validated against a real
# open-iscsi setup - please verify the sysfs path shape on your system
# (it can vary a little with kernel/multipath configuration) before
# relying on it.
#
# @param string _var variable to put the resolved /dev/sdX path into
# @param string _target target in "iqn/lun" form (lun defaults to 0)
#
info___find_iscsi() {
    local _var="$1"
    local _target="$2"
    local _lun _iqn _sess _dev

    # If no lun is specified, assume /0
    _lun=${_target##*/}
    [ "${_lun}" = "${_target}" ] && _lun=0
    _iqn=${_target%/*}

    for _sess in /sys/class/iscsi_session/session*; do
        [ -r "${_sess}/targetname" ] || continue
        [ "$(cat "${_sess}/targetname" 2>/dev/null)" = "${_iqn}" ] || continue

        _dev=$(find "${_sess}/device" -maxdepth 6 -path "*:${_lun}/block/*" -printf '%f\n' 2>/dev/null | head -n1)

        if [ -n "${_dev}" ]; then
            config_setvar "${_var}" "/dev/${_dev}"
            return 0
        fi
    done

    config_setvar "${_var}" ""
    util_err "Unable to locate iSCSI device ${_iqn}/${_lun}"
}
